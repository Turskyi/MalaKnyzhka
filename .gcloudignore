# .gcloudignore
# Exclude source control
.git/
.gitignore

# Exclude local build artifacts and IDE config
.gradle/
.idea/
# Ignore root build and composeApp build
/build/
composeApp/
# For server, ignore source and intermediate build files
server/src/
server/build/classes/
server/build/generated/
server/build/libs/
server/build/tmp/
server/build/kotlin/
iosApp/
screenshots/
.firebase/
.artifacts/
.fleet/
.vscode/
kotlin-js-store/
*.log

# Exclude Docker files (they are used by Cloud Build, but we don't need them in the context if gcloud ignores them)
# Actually, gcloud builds submit uses the current directory as context, so we SHOULD NOT ignore Dockerfile.
# But we can ignore other things.

node_modules/
.DS_Store
